# Configuração do ERP Geral.
# Copie este arquivo para .env na raiz do repositório e substitua os valores.
# Nunca versione o .env preenchido.

# URL de conexão do PostgreSQL usada pelo backend.
DATABASE_URL=postgresql+psycopg://erp_user:SUBSTITUA_A_SENHA@localhost:5432/erp_geral

# URL de um banco PostgreSQL dedicado exclusivamente aos testes de persistência.
# Use credenciais locais de teste; não reutilize um banco de produção.
TEST_DATABASE_URL=postgresql+psycopg://erp_user:SUBSTITUA_A_SENHA@localhost:5432/erp_geral_test

# A configuração de exemplo assume operação protegida.
ENVIRONMENT=production
AUTH_REQUIRED=true
AUTH_SECRET=SUBSTITUA_POR_UM_SECRET_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
AUTH_TOKEN_EXPIRATION_MINUTES=60
AUTH_BOOTSTRAP_TOKEN=SUBSTITUA_POR_UM_TOKEN_DE_BOOTSTRAP_COM_PELO_MENOS_16

# Em produção, use uma lista separada por vírgulas. Vazio significa mesma origem.
CORS_ORIGINS=
# A documentação fica desativada por padrão quando ENVIRONMENT=production.
API_DOCS_ENABLED=false
# Diretório persistente opcional para uploads e branding.
STORAGE_DIR=
