# URL de conexão do PostgreSQL usada pelo backend.
# Substitua apenas em um arquivo .env local; não versionar credenciais reais.
DATABASE_URL=postgresql+psycopg://erp_user:erp_password@localhost:5432/erp_geral

# URL de um banco PostgreSQL dedicado exclusivamente aos testes de persistência.
# Use credenciais locais de teste; não reutilize um banco de produção.
TEST_DATABASE_URL=postgresql+psycopg://erp_user:erp_password@localhost:5432/erp_geral_test

# Autenticação. Em produção, ENVIRONMENT=production força AUTH_REQUIRED=true
# e exige secrets reais, longos e fora do Git.
ENVIRONMENT=development
AUTH_REQUIRED=false
AUTH_SECRET=dev-only-erp-geral-secret-change-me
AUTH_TOKEN_EXPIRATION_MINUTES=60
AUTH_BOOTSTRAP_TOKEN=dev-bootstrap-token-change-me
